# Copiá este archivo como ".env" y completalo con los datos de tu proyecto de Firebase
# (Firebase Console -> Configuración del proyecto -> Tus apps -> Config).
# Después de editar el .env hay que reiniciar con: npx expo start -c
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
